  "$defs": {
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "request_id",
        "operation",
        "payload"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "operation": {
          "const": "hello"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extension_version",
            "browser_instance_id",
            "capabilities"
          ],
          "properties": {
            "extension_version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])"
            },
            "browser_instance_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "enum": [
                  "session_check",
                  "catalog",
                  "body",
                  "chunking"
                ]
              },
              "uniqueItems": true,
              "minItems": 0,
              "maxItems": 16
            }
          }
        }
      }
    },
